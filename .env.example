# Telegram Business auto-reply boti — sozlamalar.
# Bu faylni nusxalab qiymatlarni Railway > Variables bo'limiga kiriting. Haqiqiy qiymatlarni gitga qo'ymang.

# --- Majburiy ---

# Shu servis uchun ALOHIDA bot tokeni (@BotFather). Buyurtma botining tokenini ishlatmang.
BOT_TOKEN=

# Qidiruv API'ning bazaviy manzili, oxirida /search siz (masalan: https://sizning-api.up.railway.app)
SEARCH_API_URL=

# Qidiruv API kaliti — "X-API-Key" sarlavhasida yuboriladi
SEARCH_API_KEY=

# Topilmagan xabarlar yuboriladigan chat ID (shaxsiy chat yoki guruh: -100...)
ADMIN_CHAT_ID=

# Buyurtma botining username'i, @ belgisisiz
BUYURTMA_BOT_USERNAME=

# --- Ixtiyoriy (bo'sh qoldirilsa — standart qiymat) ---

# Bitta xabarga nechta mahsulot yuborilsin (1..10, standart 5)
MAX_RESULTS=

# Operator javobi va har bir tayyor javob bir mijozga necha soniyada bir marta yuborilsin (0 — har safar, standart 300)
OPERATOR_REPLY_COOLDOWN_SECONDS=

# Salomlashish ("Assalomu alaykum, {ism}! ...") bir mijozga necha soniyada bir marta (standart 43200 = 12 soat, 0 — har bir xabarga)
GREETING_COOLDOWN_SECONDS=

# Qidiruv API javobini kutish vaqti, millisekund (standart 8000)
SEARCH_TIMEOUT_MS=
